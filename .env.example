# Smart Mess — environment variables.
# Copy this file to .env and fill in real values. NEVER commit .env.

# ── Database ────────────────────────────────────────────────────────────
# Local dev: plain SQLite file (regenerate with `bun run db:push && bun run db:seed`)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production (Turso / libSQL): create a free DB at https://turso.tech
# DATABASE_URL="libsql://smart-mess-xxxxx.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-database-auth-token"

# ── NextAuth ─────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate a strong secret for production: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
# Required when running behind Vercel's proxy / custom domain
NEXTAUTH_TRUST_HOSTNAME="true"

# ── Setup / seeding ─────────────────────────────────────────────────────
# Random secret that authorizes the one-time /api/setup/seed?token=… call
# to populate the production DB with demo data + admin/manager accounts.
# Generate with: `openssl rand -base64 24`
SETUP_SECRET="replace-with-a-strong-random-secret"
