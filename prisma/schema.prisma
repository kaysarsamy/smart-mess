// Smart Mess — Prisma schema
// Multi-role Mess/Hostel Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// App users (admins + managers). Managed by NextAuth.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          String    @default("MANAGER") // ADMIN | MANAGER
  active        Boolean   @default(true)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  payments      Payment[]
  expenses      Expense[]
  monthlyCloses MonthlyClose[]

  @@index([role])
}

/// NextAuth (Credentials provider) — required tables.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires     DateTime
}

/// Floor grouping for rooms.
model Floor {
  id        String  @id @default(cuid())
  name      String  @unique // e.g. "1st Floor"
  level     Int     @default(1)
  rooms     Room[]
  createdAt DateTime @default(now())

  @@index([level])
}

model Room {
  id        String  @id @default(cuid())
  name      String  @unique // e.g. "Room 101"
  floorId   String
  floor     Floor  @relation(fields: [floorId], references: [id], onDelete: Restrict)
  type      String  @default("Shared") // Shared | Single | Double | Triple
  monthlyRent Float @default(6000) // default rent per seat in this room
  seats     Seat[]
  createdAt DateTime @default(now())

  @@index([floorId])
}

model Seat {
  id        String  @id @default(cuid())
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label     String  // e.g. "A", "B", "C", "1", "2"
  notes     String?
  assignments SeatAssignment[]
  createdAt DateTime @default(now())

  @@unique([roomId, label])
  @@index([roomId])
}

model Student {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  studentIdRef String?  // university/institution ID
  email        String?
  guardianName String?
  guardianPhone String?
  presentAddress String?
  permanentAddress String?
  institution  String?
  status       String   @default("ACTIVE") // ACTIVE | FORMER
  securityDeposit Float @default(0) // separate tracking
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  SeatAssignment[]
  bills         Bill[]
  payments      Payment[]

  @@index([status])
  @@index([phone])
}

/// Seat occupancy history (current + past).
model SeatAssignment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  seatId      String
  seat        Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  moveInDate  DateTime
  moveOutDate DateTime?
  monthlyRent Float
  active      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([seatId])
  @@index([active])
}

/// Monthly bill for a student.
model Bill {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month        String   // "YYYY-MM"
  amount       Float    // total billed for the month
  dueDate      DateTime
  createdAt    DateTime @default(now())

  payments     Payment[]

  @@unique([studentId, month])
  @@index([studentId])
  @@index([month])
}

model Payment {
  id           String   @id @default(cuid())
  billId       String?
  bill          Bill?   @relation(fields: [billId], references: [id], onDelete: SetNull)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount       Float
  method       String   // CASH | BKASH | NAGAD | BANK
  txnRef       String?
  payerName    String?
  receivedById String?
  receivedBy   User?    @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  note         String?
  paidAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([billId])
  @@index([studentId])
  @@index([method])
  @@index([paidAt])
}

model Expense {
  id           String   @id @default(cuid())
  category    String   // ELECTRICITY | GAS | WATER | INTERNET | SALARY | OTHERS
  amount      Float
  incurredOn  DateTime
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([incurredOn])
}

/// A month that has been reviewed & closed by admin.
model MonthlyClose {
  id           String   @id @default(cuid())
  month       String   @unique // "YYYY-MM"
  closedAt    DateTime @default(now())
  closedById  String?
  closedBy    User?    @relation(fields: [closedById], references: [id], onDelete: SetNull)
  note        String?

  createdAt   DateTime @default(now())
}

/// Key-value system settings (mess name, currency symbol, etc.)
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
